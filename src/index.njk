<section class="hero">


<div class="container hero-grid">

    <div>
        <span class="eyebrow">
            Segurança digital
        </span>

        <h1>
            Gere uma senha forte em segundos.
        </h1>

        <p class="lead">
            Crie senhas aleatórias e personalizadas diretamente no navegador.
            Sem cadastro e sem enviar sua senha para um servidor.
        </p>

        <div class="hero-actions">
            <a class="btn btn-secondary" href="/ferramentas.html">
                Ver outras ferramentas
            </a>

            <a class="btn btn-primary" href="#gerador">
                Gerar agora
            </a>
        </div>
    </div>

    <div class="generator-card" id="gerador">

        <div class="output-row">
            <div
                id="passwordOutput"
                class="password-output"
                aria-live="polite"
                aria-label="Senha gerada"
            ></div>

            <button
                id="copyPassword"
                type="button"
                class="btn btn-secondary copy-btn"
            >
                Copiar
            </button>
        </div>

        <div class="strength">
            <div class="strength-top">
                <span>Força estimada</span>
                <span id="strengthLabel">Muito forte</span>
            </div>

            <div class="strength-bar">
                <div id="strengthFill" class="strength-fill"></div>
            </div>
        </div>

        <div class="field">
            <div class="field-label">
                <span>Comprimento</span>
                <span id="lengthValue">20</span>
            </div>

            <input
                id="passwordLength"
                type="range"
                min="8"
                max="128"
                value="20"
                aria-label="Comprimento da senha"
            >
        </div>

        <div class="options">

            <label class="check">
                <input id="lowercase" type="checkbox" checked>
                Minúsculas
            </label>

            <label class="check">
                <input id="uppercase" type="checkbox" checked>
                Maiúsculas
            </label>

            <label class="check">
                <input id="numbers" type="checkbox" checked>
                Números
            </label>

            <label class="check">
                <input id="symbols" type="checkbox" checked>
                Símbolos
            </label>

            <label class="check" style="grid-column:1/-1">
                <input id="avoidAmbiguous" type="checkbox">
                Evitar caracteres ambíguos
            </label>

        </div>

        <button
            id="generatePassword"
            type="button"
            class="btn btn-primary btn-generate"
        >
            Gerar nova senha
        </button>

        <p class="privacy-note">
            Gerada localmente no navegador usando aleatoriedade
            criptograficamente segura.
        </p>

    </div>

</div>


</section>

